# Copy to .env (gitignored) and fill in. Only the server reads these; nothing reaches the browser.
# A Meta Model API key (api.meta.ai).
META_API_KEY=
# An ElevenLabs API key for the patient's voice. Without it the browser's own voice speaks.
ELEVEN_LABS=
# Optional overrides
# ELEVEN_LABS_MODEL=eleven_flash_v2_5
# LIMIT_SPEAK_PER_MINUTE=40         # per visitor
# META_BASE_URL=https://api.meta.ai/v1
# META_CASE_MODEL=muse-spark-1.3
# META_PATIENT_MODEL=muse-spark-1.3
# META_EXAMINER_MODEL=muse-spark-1.3
# META_JUDGE_MODEL=muse-spark-1.3   # npm run review only
# META_IMAGE_MODEL=muse-image-1.0   # npm run review only
# META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# PORT=8787

# Hosting (all optional)
# PORT=8787                        # hosts such as Render set this themselves
# TRUST_PROXY_HOPS=1               # proxies in front of the server: 1 on Render, 2 with Cloudflare in front
# LIMIT_SESSIONS_PER_HOUR=20       # per visitor
# LIMIT_CHAT_PER_MINUTE=30         # per visitor
# LIMIT_TRANSCRIBE_PER_MINUTE=30   # per visitor
# META_MAX_CALLS_PER_MINUTE=60     # all visitors together
# SESSION_TTL_MINUTES=120
# MAX_SESSIONS=500
